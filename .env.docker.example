# Si quieres usar un subdominio para el websocket, rellena esto con el host público.
# Si lo dejas vacío, el cliente intentará usar el host actual de la página.
CHAT_REALTIME_PUBLIC_HOST=
CHAT_REALTIME_PUBLIC_PORT=443
CHAT_REALTIME_PUBLIC_SCHEME=https
CHAT_REALTIME_PUBLIC_PATH=
